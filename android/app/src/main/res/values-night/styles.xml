<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DuttarimLaunchBase" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAF7F0</item>
        <item name="android:statusBarColor">#FAF7F0</item>
        <item name="android:navigationBarColor">#FAF7F0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="@style/DuttarimLaunchBase">
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
